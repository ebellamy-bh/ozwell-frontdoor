# Third-party tags. All three ship with production defaults baked into
# src/lib/analytics.ts, so nothing here needs setting for a normal deploy — these
# vars exist to point a build at a different property, or to blank a tag out by
# setting it to the empty string. They are build-time constants: the site is a
# static export, so a change needs a rebuild.

# GA4 measurement id. Default: G-YLP9MW52CC
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project id. Default: xsajbfrv07
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# HubSpot portal. Default: 45533062 — the portal ozwell.ai already uses.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Tags are suppressed in `pnpm dev` so localhost traffic stays out of the real GA
# property and Clarity doesn't record the dev server. Set to 1 to load them
# anyway when working on the tag wiring itself.
NEXT_PUBLIC_ENABLE_TAGS_IN_DEV=
